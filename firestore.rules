rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo tú: pega aquí el UID de tu usuario (Authentication > Usuarios).
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PEGA_AQUI_TU_UID';
    }

    // Chat público: todos leen, todos pueden escribir mensajes cortos, nadie edita; solo el administrador borra.
    match /chat/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['user', 'text', 'createdAt'])
        && request.resource.data.user is string
        && request.resource.data.user.size() > 0 && request.resource.data.user.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Solicitudes: el público solo envía; solo el administrador las lee, marca y borra.
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'song', 'artist', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.song is string
        && request.resource.data.song.size() > 0 && request.resource.data.song.size() <= 100
        && request.resource.data.artist is string && request.resource.data.artist.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
